    "machine_start_gcode": "M140 S{bed_temperature[current_extruder]} ; Set bed temp\nRESPOND MSG=\"Setting Bed Temp {bed_temperature[current_extruder]}C... \"\nM104 S150 T0 ; Set PH1 temp for probing\nRESPOND MSG=\"Setting PH1 Nozzle Temp 150C for TAP Probing...\"\n{if is_extruder_used[1]}M104 T1 S{temperature[1]}{endif}\n{if is_extruder_used[2]}M104 T2 S{temperature[2]}{endif}\n{if is_extruder_used[3]}M104 T3 S{temperature[3]}{endif}\n{if is_extruder_used[4]}M104 T4 S{temperature[4]}{endif}\nG28 ; Home\nDOCK\nTEMPERATURE_WAIT SENSOR=heater_bed MINIMUM={bed_temperature[current_extruder]}\nTEMPERATURE_WAIT SENSOR=extruder MINIMUM=150\nG28 Z ; Home Z\nRESPOND MSG=\"Performing Bed Scan...\"\nBED_MESH_SCAN\nRESPOND MSG=\"Performing TAP Calibration...\"\n_CAL_SELECT_T0 ; Select and wipe PH1\nTAP\nDOCK\nM104 S0 T0 ; Turn off PH1 after tap\n; Set temperatures for all used extruders (non-blocking)\n{if is_extruder_used[0]}M104 T0 S{temperature[0]}{endif}\n{if is_extruder_used[1]}M104 T1 S{temperature[1]}{endif}\n{if is_extruder_used[2]}M104 T2 S{temperature[2]}{endif}\n{if is_extruder_used[3]}M104 T3 S{temperature[3]}{endif}\n{if is_extruder_used[4]}M104 T4 S{temperature[4]}{endif}\n; Wait for each used extruder to reach or exceed target temp\n{if is_extruder_used[0]}TEMPERATURE_WAIT SENSOR=extruder MINIMUM={temperature[0]}{endif}\n{if is_extruder_used[1]}TEMPERATURE_WAIT SENSOR=extruder1 MINIMUM={temperature[1]}{endif}\n{if is_extruder_used[2]}TEMPERATURE_WAIT SENSOR=extruder2 MINIMUM={temperature[2]}{endif}\n{if is_extruder_used[3]}TEMPERATURE_WAIT SENSOR=extruder3 MINIMUM={temperature[3]}{endif}\n{if is_extruder_used[4]}TEMPERATURE_WAIT SENSOR=extruder4 MINIMUM={temperature[4]}{endif}\n; Prime each used extruder\n{if is_extruder_used[0]}_PRIME_PH1{endif}\n{if is_extruder_used[1]}_PRIME_PH2{endif}\n{if is_extruder_used[2]}_PRIME_PH3{endif}\n{if is_extruder_used[3]}_PRIME_PH4{endif}\n{if is_extruder_used[4]}_PRIME_PH5{endif}\nUPDATE_DELAYED_GCODE ID=FILTER_FAN_OFF DURATION=0\nSET_FAN_SPEED FAN=filter_fan SPEED=1\n{if initial_tool == 0}SELECT_PH1\n{elsif initial_tool == 1}SELECT_PH2\n{elsif initial_tool == 2}SELECT_PH3\n{elsif initial_tool == 3}SELECT_PH4\n{elsif initial_tool == 4}SELECT_PH5\n{endif}\nG92 E0",
